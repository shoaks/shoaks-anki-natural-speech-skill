{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anki Natural Speech Note V2",
  "type": "object",
  "required": [
    "ID",
    "Target",
    "NaturalMeaning",
    "OriginalInput",
    "Example",
    "Language",
    "AudioNatural"
  ],
  "properties": {
    "ID": {
      "type": "string",
      "minLength": 1
    },
    "Target": {
      "type": "string",
      "minLength": 1
    },
    "NaturalMeaning": {
      "type": "string"
    },
    "Context": {
      "type": "string"
    },
    "Chunks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Grammar": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "Vocabulary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "Usage": {
      "type": "string"
    },
    "Pronunciation": {
      "type": "string"
    },
    "NaturalSpeech": {
      "type": "string"
    },
    "Example": {
      "type": "string"
    },
    "OriginalInput": {
      "type": "string"
    },
    "CorrectionNote": {
      "type": "string"
    },
    "AudioNatural": {
      "type": "string",
      "minLength": 1
    },
    "AudioCareful": {
      "type": [
        "string",
        "null"
      ]
    },
    "Image": {
      "type": [
        "string",
        "null"
      ]
    },
    "Tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Language": {
      "type": "string"
    },
    "Dialect": {
      "type": [
        "string",
        "null"
      ]
    },
    "Difficulty": {
      "type": [
        "string",
        "null"
      ]
    },
    "Source": {
      "type": "string"
    },
    "ImageMode": {
      "enum": [
        "generate",
        "optional",
        "skip"
      ]
    },
    "InputType": {
      "enum": [
        "word",
        "phrase",
        "sentence",
        "other"
      ]
    },
    "PartOfSpeech": {
      "type": [
        "string",
        "null"
      ]
    },
    "CardPolicy": {
      "type": "object",
      "properties": {
        "comprehension": {
          "type": "boolean"
        },
        "listening": {
          "type": "boolean"
        },
        "production": {
          "type": "boolean"
        },
        "error_correction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "InputType": {
            "const": "word"
          }
        },
        "required": [
          "InputType"
        ]
      },
      "then": {
        "properties": {
          "Example": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
