{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anki Natural Speech Note V2",
  "type": "object",
  "required": [
    "ID",
    "Target",
    "NaturalMeaning",
    "OriginalInput",
    "Examples",
    "Language",
    "InputType",
    "AudioNatural",
    "AudioProvider",
    "CardPolicy"
  ],
  "properties": {
    "ID": {
      "type": "string",
      "minLength": 1
    },
    "Target": {
      "type": "string",
      "minLength": 1
    },
    "NaturalMeaning": {
      "type": "string",
      "minLength": 1
    },
    "Context": {
      "type": "string"
    },
    "Chunks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Grammar": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "Vocabulary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "Usage": {
      "type": "string"
    },
    "Pronunciation": {
      "type": "string"
    },
    "NaturalSpeech": {
      "type": "string"
    },
    "Examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Text",
          "AudioNatural"
        ],
        "properties": {
          "Text": {
            "type": "string",
            "minLength": 1
          },
          "NaturalMeaning": {
            "type": "string"
          },
          "AudioNatural": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "OriginalInput": {
      "type": "string"
    },
    "CorrectionNote": {
      "type": "string"
    },
    "AudioNatural": {
      "type": "string",
      "minLength": 1
    },
    "AudioCareful": {
      "type": [
        "string",
        "null"
      ]
    },
    "Image": {
      "type": [
        "string",
        "null"
      ]
    },
    "Tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Language": {
      "type": "string"
    },
    "Dialect": {
      "type": [
        "string",
        "null"
      ]
    },
    "Difficulty": {
      "type": [
        "string",
        "null"
      ]
    },
    "Source": {
      "type": "string"
    },
    "ImageMode": {
      "enum": [
        "generate",
        "optional",
        "skip"
      ]
    },
    "InputType": {
      "enum": [
        "word",
        "phrase",
        "sentence",
        "other"
      ]
    },
    "PartOfSpeech": {
      "type": [
        "string",
        "null"
      ]
    },
    "CardPolicy": {
      "type": "object",
      "properties": {
        "comprehension": {
          "type": "boolean"
        },
        "listening": {
          "type": "boolean"
        },
        "production": {
          "type": "boolean"
        },
        "error_correction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "comprehension",
        "listening",
        "production",
        "error_correction"
      ]
    },
    "AudioProvider": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "auto"
      }
    },
    "AudioModel": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "InputType": {
            "enum": [
              "word",
              "phrase",
              "sentence"
            ]
          }
        },
        "required": [
          "InputType"
        ]
      },
      "then": {
        "properties": {
          "Examples": {
            "type": "array",
            "minItems": 4
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
