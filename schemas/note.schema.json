{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anki Audio-First Note V3",
  "type": "object",
  "required": [
    "ID",
    "OriginalInput",
    "Target",
    "NaturalMeaning",
    "TargetAudio",
    "Examples",
    "Chunks",
    "Language",
    "InputType",
    "AudioProvider",
    "CardPolicy"
  ],
  "$defs": {
    "token": {
      "type": "object",
      "required": ["Text", "GlossID", "IsPunctuation"],
      "properties": {
        "Text": {"type": "string", "minLength": 1},
        "GlossID": {"type": ["string", "null"]},
        "IsPunctuation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "gloss": {
      "type": "object",
      "required": ["ID", "Meaning"],
      "properties": {
        "ID": {"type": "string", "minLength": 1},
        "Meaning": {"type": "string", "minLength": 1},
        "Lemma": {"type": ["string", "null"]},
        "PartOfSpeech": {"type": ["string", "null"]},
        "Note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "required": ["Text", "NaturalMeaning", "AudioNatural", "Tokens", "Glosses"],
      "properties": {
        "Text": {"type": "string", "minLength": 1},
        "NaturalMeaning": {"type": "string", "minLength": 1},
        "AudioNatural": {"type": "string", "minLength": 1},
        "Tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/token"}
        },
        "Glosses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gloss"}
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "ID": {"type": "string", "minLength": 1},
    "OriginalInput": {"type": "string"},
    "Target": {"type": "string", "minLength": 1},
    "NaturalMeaning": {"type": "string", "minLength": 1},
    "TargetAudio": {"type": "string", "minLength": 1},
    "Examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/example"}
    },
    "Chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Form", "Meaning"],
        "properties": {
          "Form": {"type": "string", "minLength": 1},
          "Meaning": {"type": "string", "minLength": 1},
          "Note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "CorrectionNote": {"type": ["string", "null"]},
    "Grammar": {"type": ["string", "null"]},
    "Usage": {"type": ["string", "null"]},
    "Pronunciation": {"type": ["string", "null"]},
    "NaturalSpeech": {"type": ["string", "null"]},
    "Language": {"type": "string", "minLength": 1},
    "Dialect": {"type": ["string", "null"]},
    "InputType": {"enum": ["word", "phrase", "sentence", "other"]},
    "PartOfSpeech": {"type": ["string", "null"]},
    "Tags": {"type": "array", "items": {"type": "string"}},
    "Source": {"type": ["string", "null"]},
    "AudioProvider": {
      "type": "string",
      "minLength": 1,
      "not": {"const": "auto"}
    },
    "AudioModel": {"type": ["string", "null"]},
    "CardPolicy": {
      "type": "object",
      "required": ["listening"],
      "properties": {
        "listening": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
